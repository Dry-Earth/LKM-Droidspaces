name: "[Maintenance] Sync upstream _patchHarmony"

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Backup current main and fast-forward to upstream
        run: |
          set -eux
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git tag -f pre-sync-20261106 HEAD
          git push -f origin refs/tags/pre-sync-20261106
          git remote add upstream https://github.com/Dere3046/_patchHarmony.git
          git fetch upstream main
          parent=$(git rev-parse origin/main)
          git reset --hard 9f656329d67ad5011770003b96b98a56c886d525
          # 让新提交的 parent 是当前 main，这样 diff 里没有 workflow 变更；
          # GITHUB_TOKEN 不允许创建/更新 workflow 文件。
          git reset --soft "$parent"
          git checkout pre-sync-20261106 -- .github/workflows
          rm -f .github/workflows/native.yml
          git add -A
          git commit -m "sync upstream _patchHarmony 9f65632"
          git push -f origin HEAD:main
          echo "synced to $(git rev-parse HEAD)"
